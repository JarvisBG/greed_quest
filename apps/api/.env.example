PORT=3000
# Prod : PostgreSQL hébergé. Vide = PGlite embarqué.
DATABASE_URL=
# Dev : dossier du PGlite persistant (vide = en mémoire, perdu à l'arrêt).
PGLITE_DIR=.data/pglite
GQ_SECRET=change-moi
GQ_ADMIN_CODE=change-moi-aussi
# Origines des fronts (CORS), séparées par des virgules ; vide = toutes.
CORS_ORIGINS=
